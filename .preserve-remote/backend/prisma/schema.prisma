// ============================================================
//  BOTFLOW ADS — Prisma Schema
//  Telegram-native Sponsored Post Ads Network
// ------------------------------------------------------------
//  MONEY RULE: every monetary value is stored as an INTEGER
//  in minor units (cents / paisa). Never use Float for money.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  PENDING_REVIEW
  SUSPENDED
  BANNED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  FINANCE_MANAGER
  SUPPORT_AGENT
  ANALYST
}

enum ChannelStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  INACTIVE
  ATTENTION_REQUIRED
}

enum ChannelCategory {
  NEWS
  TECHNOLOGY
  EDUCATION
  ENTERTAINMENT
  GAMING
  BUSINESS
  SHOPPING
  DEALS
  JOBS
  SPORTS
  CRYPTO
  COMMUNITY
  OTHER
}

enum PricingModel {
  FIXED
  CPM
  CPC
  HYBRID
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum AdFormat {
  TEXT
  IMAGE
  IMAGE_TEXT
  BUTTON
}

enum PromotionTarget {
  CHANNEL
  GROUP
  BOT
  WEBSITE
  PRODUCT
  SERVICE
  APP
  BRAND
}

enum AdPostStatus {
  QUEUED
  AWAITING_APPROVAL
  PROCESSING
  PUBLISHED
  FAILED
  SKIPPED
  RETRYING
  REJECTED
  DELETED
}

enum DeliveryJobStatus {
  PENDING
  SCHEDULED
  LOCKED
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
  AWAITING_APPROVAL
}

enum TransactionType {
  DEPOSIT
  CAMPAIGN_CHARGE
  PUBLISHER_EARNING
  WITHDRAWAL
  REFUND
  PLATFORM_FEE
  REFERRAL_REWARD
  MANUAL_ADJUSTMENT
  ESCROW_HOLD
  ESCROW_RELEASE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum DepositStatus {
  PENDING
  VERIFIED
  REJECTED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

enum TicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSenderType {
  USER
  ADMIN
  SYSTEM
}

enum ReportReason {
  SCAM
  SPAM
  MISLEADING
  BROKEN_LINK
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  CAMPAIGN_APPROVED
  CAMPAIGN_REJECTED
  CAMPAIGN_STARTED
  CAMPAIGN_COMPLETED
  CAMPAIGN_PAUSED
  BUDGET_LOW
  NEW_AD_REQUEST
  AD_PUBLISHED
  EARNINGS_ADDED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_PAID
  WITHDRAWAL_REJECTED
  DEPOSIT_VERIFIED
  CHANNEL_APPROVED
  CHANNEL_REJECTED
  CHANNEL_PERMISSION_PROBLEM
  DELIVERY_FAILED
  FRAUD_ALERT
  SYSTEM

  /// Publisher money that has finished its hold period and can now be withdrawn.
  /// Fired on the pending -> available transition, which previously happened
  /// silently: a publisher had no way to know when their money became spendable.
  EARNINGS_AVAILABLE
  /// Sign-in or sensitive account change from a device/location we have not
  /// seen for this user before.
  SECURITY_ALERT
  /// An invoice has been issued for an advertiser's billing period.
  INVOICE_READY
  /// A conversion was attributed to one of the advertiser's campaigns.
  CONVERSION_RECORDED
}

enum FraudType {
  CLICK_FLOOD
  DUPLICATE_CLICK
  SELF_CLICK
  ABNORMAL_CTR
  REFERRAL_ABUSE
  MULTI_ACCOUNT
  AUTOMATED_ACTIVITY
  SUSPICIOUS_ACCOUNT
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DeliveryErrorCode {
  BOT_NOT_ADMIN
  MISSING_POST_PERMISSION
  CHANNEL_NOT_FOUND
  CHANNEL_UNAVAILABLE
  TELEGRAM_API_ERROR
  CHAT_WRITE_FORBIDDEN
  RATE_LIMITED
  BUDGET_EXHAUSTED
  CHANNEL_SUSPENDED
  PUBLISHER_REJECTED
  UNKNOWN
}

enum ReferralStatus {
  PENDING
  REWARDED
  REJECTED
}

// ============================================================
//  USERS & ADMINS
// ============================================================

model User {
  id           String     @id @default(cuid())
  telegramId   BigInt     @unique @map("telegram_id")
  username     String?
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  languageCode String?    @map("language_code")
  photoUrl     String?    @map("photo_url")
  isPremium    Boolean    @default(false) @map("is_premium")
  status       UserStatus @default(ACTIVE)

  isAdvertiser Boolean @default(true) @map("is_advertiser")
  isPublisher  Boolean @default(true) @map("is_publisher")

  /// Optional. Everything user-facing used to be Telegram-only, which makes an
  /// advertiser who blocks the bot unreachable — invoices and account recovery
  /// both need a channel that does not depend on Telegram.
  email           String?   @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Opt-out switch for non-transactional email (digests, product news).
  /// Transactional mail — invoices, security alerts — ignores this by design.
  emailOptIn      Boolean   @default(true) @map("email_opt_in")
  /// Single-use token for the verification link.
  emailVerifyToken String?  @map("email_verify_token")
  emailVerifySentAt DateTime? @map("email_verify_sent_at")

  referralCode String  @unique @map("referral_code")
  referredById String? @map("referred_by_id")
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")

  // Running totals — denormalised for fast dashboards.
  // The Transaction ledger remains the source of truth.
  totalEarnedCents    Int @default(0) @map("total_earned_cents")
  totalSpentCents     Int @default(0) @map("total_spent_cents")
  totalWithdrawnCents Int @default(0) @map("total_withdrawn_cents")
  totalDepositedCents Int @default(0) @map("total_deposited_cents")

  adminUser        AdminUser?
  wallet           Wallet?
  channels         Channel[]
  campaigns        Campaign[]
  adPosts          AdPost[]           @relation("AdPostPublisher")
  transactions     Transaction[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]
  earnings         PublisherEarning[]
  sentReferrals    Referral[]         @relation("Referrer")
  receivedReferral Referral?          @relation("Referred")
  notifications    Notification[]
  tickets          SupportTicket[]    @relation("TicketOwner")
  ticketMessages   TicketMessage[]
  reports          Report[]
  fraudEvents      FraudEvent[]
  auditLogs        AuditLog[]
  clicks           Click[]
  subscriptions    Subscription[]

  /// Advertiser programmatic access. Both are revoked, never deleted, so an
  /// audit trail of what could reach the API survives revocation.
  apiKeys          AdvertiserApiKey[]
  webhookEndpoints WebhookEndpoint[]

  /// Billing. An advertiser who spends money here must be able to get a
  /// document out of the platform for their accountant.
  invoices         Invoice[]

  /// Sign-in history, used to decide whether a login is from a known device.
  loginEvents      LoginEvent[]

  /// Premium membership. Denormalised from the active Subscription row so an
  /// entitlement check never needs a join on the hot path.
  premiumTier  PlanTier  @default(FREE) @map("premium_tier")
  premiumUntil DateTime? @map("premium_until")

  lastSeenAt      DateTime? @map("last_seen_at")
  lastBalanceAt   DateTime? @map("last_balance_at")
  suspendedReason String?   @map("suspended_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([referredById])
  @@map("users")
}

model AdminUser {
  id          String    @id @default(cuid())
  userId      String    @unique @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        AdminRole @default(MODERATOR)
  permissions Json      @default("[]") // extra granular permission keys
  isActive    Boolean   @default(true) @map("is_active")
  createdById String?   @map("created_by_id")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([role])
  @@index([isActive])
  @@map("admin_users")
}

// ============================================================
//  WALLET & FINANCE
// ============================================================

/// One wallet per user. Because a user holds BOTH advertiser and
/// publisher roles, a single ledger-backed wallet with reserves is
/// simpler and far less error-prone than two disconnected balances.
model Wallet {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  availableCents Int    @default(0) @map("available_cents") // spendable / withdrawable
  reservedCents  Int    @default(0) @map("reserved_cents") // escrowed for running campaigns
  pendingCents   Int    @default(0) @map("pending_cents") // earnings inside hold period
  currency       String @default("USD")

  totalDepositedCents Int @default(0) @map("total_deposited_cents")
  totalSpentCents     Int @default(0) @map("total_spent_cents")
  totalEarnedCents    Int @default(0) @map("total_earned_cents")
  totalWithdrawnCents Int @default(0) @map("total_withdrawn_cents")
  totalRefundedCents  Int @default(0) @map("total_refunded_cents")

  version   Int      @default(0) // optimistic-lock counter
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wallets")
}

/// Append-only ledger. NEVER update or delete a row here.
model Transaction {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  type          TransactionType
  status        TransactionStatus @default(COMPLETED)
  amountCents   Int               @map("amount_cents") // signed: + credit, - debit
  currency      String            @default("USD")
  /// Both sides of every movement are stored, so a single ledger row is
  /// self-contained and auditable without replaying history.
  balanceBefore Int?              @map("balance_before_cents")
  balanceAfter  Int?              @map("balance_after_cents")

  /// Unique idempotency key. A duplicate payment webhook reuses the same
  /// reference and is rejected by the unique index instead of double-crediting.
  reference      String  @unique
  referenceType  String? @map("reference_type")
  idempotencyKey String? @unique @map("idempotency_key")

  campaignId   String? @map("campaign_id")
  channelId    String? @map("channel_id")
  adPostId     String? @map("ad_post_id")
  withdrawalId String? @map("withdrawal_id")
  depositId    String? @map("deposit_id")
  earningId    String? @map("earning_id")

  description String?
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type])
  @@index([status])
  @@index([campaignId])
  @@map("transactions")
}

/// One deposit address per (asset, chain) pair, maintained by an operator from
/// the admin panel.
///
/// An address belongs to the PAIR, not the asset: USDT on TON and USDT on BEP20
/// are different wallets, and a depositor who sends to the wrong chain loses the
/// money with no recourse. So a network with no row here — or an inactive one —
/// must NOT appear on the deposit screen at all. Between "no address" and "the
/// wrong address" only the first is recoverable.
model CryptoDepositAddress {
  id        String   @id @default(cuid())
  /// One of CRYPTO_NETWORKS (shared/src/enums.ts), e.g. USDT_TRC20.
  network   String   @unique
  address   String
  /// Destination tag / memo for chains that require one. Null when not needed.
  memo      String?
  /// Helps an operator tell two wallets apart in the admin panel.
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("crypto_deposit_addresses")
}

/// The state of one observed on-chain transfer into a deposit address.
///
/// The unique key is (network, txHash). A rescan, a reorg, or two scanners
/// overlapping MUST NOT produce a second row — because a second row is a second
/// credit, and a chain has no way to take money back on our behalf.
enum CryptoTransferStatus {
  /// Seen on chain, not yet credited. Where everything starts.
  DETECTED
  /// Credited to a wallet. Terminal.
  CREDITED
  /// An operator decided this must not be credited (dust, a test transfer, a
  /// transfer that is not a deposit). Terminal, and the reason is recorded.
  IGNORED
}

/// One incoming on-chain transfer, and what we decided to do about it.
model CryptoChainTransfer {
  id          String   @id @default(cuid())
  /// One of CRYPTO_NETWORKS (shared/src/enums.ts).
  network     String
  /// The chain's transaction hash. Unique per network with it.
  txHash      String   @map("tx_hash")
  /// The asset as the chain identified it — a token contract address on the EVM
  /// chains, the native symbol where there is none.
  asset       String
  fromAddress String   @map("from_address")
  toAddress   String   @map("to_address")

  /// The amount in the asset's SMALLEST unit, as a STRING.
  ///
  /// Never a number: an 18-decimal token exceeds what a JS float can hold
  /// exactly, so a numeric column would silently round somebody's money.
  amountRaw   String   @map("amount_raw")

  /// The price used, frozen at observation time.
  priceUsdCents Int?   @map("price_usd_cents")
  /// `amountRaw` converted to USD cents at that price. Null when no price could
  /// be obtained — an unpriced transfer is held rather than credited at a guess.
  amountCents   Int?   @map("amount_cents")

  blockNumber   BigInt?  @map("block_number")
  confirmations Int      @default(0)

  status CryptoTransferStatus @default(DETECTED)

  /// The deposit this became. Unique, so one transfer can only ever be credited
  /// into one deposit, however many times the credit path runs.
  depositId  String?  @unique @map("deposit_id")
  note       String?

  observedAt DateTime  @default(now()) @map("observed_at")
  creditedAt DateTime? @map("credited_at")

  @@unique([network, txHash])
  @@index([status])
  @@index([toAddress])
  @@map("crypto_chain_transfers")
}

model Deposit {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountCents Int           @map("amount_cents")
  currency    String        @default("USD")
  /// One of PAYMENT_METHODS (shared/src/enums.ts): crypto | telegram_stars.
  method      String
  status      DepositStatus @default(PENDING)

  /// What comes OFF this deposit before it reaches the wallet, frozen at
  /// creation so a later rate change cannot rewrite the economics of a past
  /// deposit. `feeBps` = basis points (4800 = 48%); `feeCents` = that in money.
  ///
  /// THE DEPOSITOR PAYS IT: `amountCents - feeCents` is what gets credited.
  /// (An earlier version of this comment claimed the platform bore it and the
  /// depositor was credited in full. That was wrong, and exactly the kind of
  /// stale note that gets someone to write a double-credit.)
  feeBps   Int @default(0) @map("fee_bps")
  feeCents Int @default(0) @map("fee_cents")

  /// Telegram Stars only: how many Stars were actually charged, before the
  /// conversion to cents. Kept because the ledger is in USD cents but Telegram's
  /// statement — and any refund — is in Stars, and reconciling the two needs the
  /// original figure rather than a rounded-back derivation.
  starsAmount Int? @map("stars_amount")

  /// Unique per gateway — protects against webhook replay.
  gatewayRef   String? @unique @map("gateway_ref")
  gatewayTxnId String? @map("gateway_txn_id")
  proofUrl     String? @map("proof_url")
  senderInfo   String? @map("sender_info")

  verifiedById String?   @map("verified_by_id")
  verifiedAt   DateTime? @map("verified_at")
  note         String?
  rawPayload   Json?     @map("raw_payload")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status])
  @@index([method])
  @@map("deposits")
}

model Withdrawal {
  id     String           @id @default(cuid())
  userId String           @map("user_id")
  user   User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status WithdrawalStatus @default(PENDING)

  amountCents    Int    @map("amount_cents")
  feeCents       Int    @default(0) @map("fee_cents")
  netAmountCents Int    @map("net_amount_cents")
  currency       String @default("USD")

  method         String // crypto
  accountDetails Json?   @map("account_details")
  accountMasked  String? @map("account_masked")

  processedById String?   @map("processed_by_id")
  processedAt   DateTime? @map("processed_at")
  txRef         String?   @map("tx_ref")
  rejectReason  String?   @map("reject_reason")
  note          String?

  /// Raised by the payout-limits check (large amount, several requests in 24h,
  /// or a previous rejection). It does NOT block the request — it tells the
  /// admin queue which rows deserve a human look before money leaves.
  requiresReview Boolean @default(false) @map("requires_review")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status])
  @@index([requiresReview])
  @@map("withdrawals")
}

model PublisherEarning {
  id          String  @id @default(cuid())
  publisherId String  @map("publisher_id")
  publisher   User    @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  adPostId    String  @unique @map("ad_post_id")
  adPost      AdPost  @relation(fields: [adPostId], references: [id], onDelete: Restrict)
  channelId   String  @map("channel_id")
  channel     Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  /// Nullable: a HOUSE post earns the publisher without any campaign existing.
  campaignId  String? @map("campaign_id")

  grossCents       Int @map("gross_cents")
  platformFeeCents Int @map("platform_fee_cents")
  netCents         Int @map("net_cents")

  status      EarningStatus @default(PENDING)
  availableAt DateTime?     @map("available_at")
  paidAt      DateTime?     @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([publisherId, status])
  @@index([status, createdAt])
  @@index([channelId])
  @@map("publisher_earnings")
}

model Referral {
  id             String @id @default(cuid())
  referrerId     String @map("referrer_id")
  referrer       User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String @unique @map("referred_user_id")
  referredUser   User   @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  status      ReferralStatus @default(PENDING)
  rewardCents Int            @default(0) @map("reward_cents")
  rewardedAt  DateTime?      @map("rewarded_at")
  note        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([referrerId, status])
  @@map("referrals")
}

// ============================================================
//  CHANNELS (PUBLISHER SIDE)
// ============================================================

model Channel {
  id      String @id @default(cuid())
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  telegramChannelId BigInt  @unique @map("telegram_channel_id")
  username          String? @unique
  title             String
  description       String?
  photoUrl          String? @map("photo_url")
  inviteLink        String? @map("invite_link")

  category ChannelCategory @default(OTHER)
  language String?         @default("en")
  country  String?         @default("BD")

  subscriberCount    Int @default(0) @map("subscriber_count")
  avgViews           Int @default(0) @map("avg_views")
  avgPostPerformance Int @default(0) @map("avg_post_performance")
  totalPostsTracked  Int @default(0) @map("total_posts_tracked")

  status          ChannelStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason")
  adminNote       String?       @map("admin_note")

  // Bot permission snapshot — refreshed by permission.worker
  botIsAdmin          Boolean   @default(false) @map("bot_is_admin")
  canPostMessages     Boolean   @default(false) @map("can_post_messages")
  canEditMessages     Boolean   @default(false) @map("can_edit_messages")
  canDeleteMessages   Boolean   @default(false) @map("can_delete_messages")
  lastPermissionCheck DateTime? @map("last_permission_check")

  // Pricing
  pricingModel PricingModel @default(FIXED) @map("pricing_model")
  adPriceCents Int          @default(0) @map("ad_price_cents") // fixed price per post
  cpmRateCents Int          @default(0) @map("cpm_rate_cents") // per 1000 views

  /// What this publisher EARNS per 1,000 views. Separate from cpmRateCents
  /// above, which is what an ADVERTISER pays. Null = use the platform rate from
  /// the setting `publisher_cpm_rate_cents` (default 180 = $1.80 per 1,000).
  publisherCpmRateCents Int?   @map("publisher_cpm_rate_cents")
  /// FIXED = flat price per post. CPM = paid on measured views.
  earningModel          String @default("FIXED") @map("earning_model")

  /// Optional per-channel override of the platform 40/60 paid-to-house mix.
  paidAdSharePercent Int? @map("paid_ad_share_percent")
  cpcRateCents       Int  @default(0) @map("cpc_rate_cents") // per click

  // Delivery preferences
  autoApprovePosts Boolean @default(true) @map("auto_approve_posts")

  /// Publisher switch. When false the channel stays discoverable in the
  /// marketplace but receives no new delivery.
  acceptAds           Boolean             @default(true) @map("accept_ads")
  /// Publisher-set floor. An advertiser whose offer is below this can never
  /// create a campaign against this channel.
  minAdPriceCents     Int                 @default(0) @map("min_ad_price_cents")
maxCampaignsPerHour Int? @map("max_campaigns_per_hour")
  healthStatus        ChannelHealthStatus @default(HEALTHY) @map("health_status")
  /// 0-100, written by the channel-health refresh job. Advertisers see this as a
  /// quality signal; it is deliberately separate from `status`, which is the
  /// review lifecycle (PENDING / APPROVED / SUSPENDED).
  healthScore         Int                 @default(100) @map("health_score")
  healthCheckedAt     DateTime?           @map("health_checked_at")

  blockedDomains     BlockedDomain[]
  blocklist          PublisherBlocklist[]
  maxPostsPerDay     Int                  @default(3) @map("max_posts_per_day")
  minHoursBetweenAds Int                  @default(4) @map("min_hours_between_ads")

  /// The publisher's weekly posting schedule: weekday ("0" = Sunday) -> the
  /// channel-local "HH:mm" times a sponsored post may go out at. NULL means no
  /// schedule is set, and only maxPostsPerDay + minHoursBetweenAds apply. The
  /// total across the week is capped at MAX_WEEKLY_POSTS (shared/src/schemas.ts);
  /// the shape is validated there, so the DB stores it as-is.
  postingSchedule Json? @map("posting_schedule")

  // Counters
  totalAdsPublished Int @default(0) @map("total_ads_published")
  totalEarnedCents  Int @default(0) @map("total_earned_cents")

  stats        ChannelStat[]
  campaigns    CampaignTarget[]
  adPosts      AdPost[]
  earnings     PublisherEarning[]
  deliveryJobs DeliveryJob[]
  clicks       Click[]

  approvedAt DateTime? @map("approved_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@index([country, language])
  @@index([subscriberCount])
  @@index([ownerId])
  @@map("channels")
}

model ChannelStat {
  id        String   @id @default(cuid())
  channelId String   @map("channel_id")
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  subscribers Int @default(0)
  avgViews    Int @default(0) @map("avg_views")
  postsCount  Int @default(0) @map("posts_count")
  viewsTotal  Int @default(0) @map("views_total")
  clicksTotal Int @default(0) @map("clicks_total")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([channelId, date])
  @@index([date])
  @@map("channel_stats")
}

// ============================================================
//  CAMPAIGNS (ADVERTISER SIDE)
// ============================================================

model Campaign {
  id           String @id @default(cuid())
  advertiserId String @map("advertiser_id")
  advertiser   User   @relation(fields: [advertiserId], references: [id], onDelete: Restrict)

  name            String
  promotionTarget PromotionTarget @default(CHANNEL) @map("promotion_target")
  pricingModel    PricingModel    @default(FIXED) @map("pricing_model")
  status          CampaignStatus  @default(DRAFT)

  budgetTotalCents    Int @map("budget_total_cents")
  budgetSpentCents    Int @default(0) @map("budget_spent_cents")
  budgetReservedCents Int @default(0) @map("budget_reserved_cents")
  platformFeePercent  Int @default(20) @map("platform_fee_percent")

  frequencyPerChannel Int @default(1) @map("frequency_per_channel")

  /// Drives the platform category policy and publisher category blocklists.
  category ChannelCategory?

  /// ---- Advertiser-facing plan -------------------------------------------
  /// A budget buys an ESTIMATED REACH, not a single post. Both figures are
  /// computed at creation time from the settings advertiser_cpm_cents +
  /// reach_floor_percent / reach_ceil_percent, and frozen here so the number the
  /// advertiser was shown cannot drift afterwards.
  estimatedReachMin Int?    @map("estimated_reach_min")
  estimatedReachMax Int?    @map("estimated_reach_max")
  /// What `reach` is measured in: SUBSCRIBERS (default) or AVG_VIEWS.
  reachBasis        String? @map("reach_basis")
  /// Frozen allocation plan: selected channels, their prices, expected posts.
  planSnapshot      Json?   @map("plan_snapshot")

  /// Platform-owned promotional inventory. House slots are not billed to any
  /// advertiser; they exist so a channel is never left with an empty slot and
  /// the 40/60 paid-to-house mix can be honoured.
  isHouse         Boolean @default(false) @map("is_house")
  houseOwnerLabel String? @map("house_owner_label")

  /// The language the advertiser wants their creative written in. A paid post is
  /// published in THIS language; only BotFlow's own house posts are English-only.
  language String? @default("en")

  /// { categories: string[], countries: string[], languages: string[],
  ///   subscriberMin: number, subscriberMax: number,
  ///   avgViewsMin: number, avgViewsMax: number }
  targeting       Json    @default("{}")
  isAutoTargeting Boolean @default(false) @map("is_auto_targeting")

  startAt DateTime? @map("start_at")
  endAt   DateTime? @map("end_at")

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?   @map("review_note")
  rejectReason String?   @map("reject_reason")

  ads          Ad[]
  targets      CampaignTarget[]
  adPosts      AdPost[]
  deliveryJobs DeliveryJob[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([advertiserId, status])
  @@index([status])
  @@index([startAt])
  @@map("campaigns")
}

/// Explicit advertiser-selected channel for a campaign.
model CampaignTarget {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channelId  String   @map("channel_id")
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  priceCents Int      @default(0) @map("price_cents")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([campaignId, channelId])
  @@index([channelId])
  @@map("campaign_targets")
}

/// Ad creative. A campaign may hold several for rotation.
model Ad {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  format         AdFormat @default(TEXT)
  text           String
  imageUrl       String?  @map("image_url")
  buttonText     String?  @map("button_text")
  buttonUrl      String?  @map("button_url")
  destinationUrl String?  @map("destination_url")

  /// Short slug used in the public tracking redirect: /c/:slug
  trackingSlug String @unique @map("tracking_slug")

  weight Int @default(1)

  /// Content fingerprint used by duplicate-advertisement detection, plus the
  /// current version number (history lives in AdCreativeVersion).
  textHash  String? @map("text_hash")
  imageHash String? @map("image_hash")
  version   Int     @default(1)
  isActive  Boolean @default(true) @map("is_active")

  adPosts     AdPost[]
  clicks      Click[]
  impressions Impression[]
  versions    AdCreativeVersion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId, isActive])
  @@map("ads")
}

// ============================================================
//  DELIVERY
// ============================================================

/// One row per (campaign × channel) intent to publish.
model DeliveryJob {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channelId  String   @map("channel_id")
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  adId       String?  @map("ad_id")

  /// Position of this job within its (campaign, channel, ad) group. A campaign
  /// with frequencyPerChannel = 3 must produce 3 jobs even when it has a single
  /// creative, so the uniqueness key includes this counter — otherwise
  /// createMany({ skipDuplicates: true }) silently collapses them into one.
  seq        Int      @default(0) @map("seq")

  status      DeliveryJobStatus @default(PENDING)
  attempts    Int               @default(0)
  maxAttempts Int               @default(3) @map("max_attempts")
  scheduledAt DateTime          @default(now()) @map("scheduled_at")
  lockedAt    DateTime?         @map("locked_at")
  processedAt DateTime?         @map("processed_at")

  /// Set when the publisher manually approves a post in a channel that has
  /// `autoApprovePosts = false`. Without this flag an approved job would fall
  /// back into AWAITING_APPROVAL on every retry.
  publisherApprovedAt DateTime? @map("publisher_approved_at")

  /// Pricing snapshot taken when the job was planned. If a publisher raises
  /// their price mid-campaign, an existing campaign must keep paying the
  /// price it agreed to. Never read Channel.adPriceCents at publish time.
  priceCents         Int @default(0) @map("price_cents")
  platformFeePercent Int @default(20) @map("platform_fee_percent")

  /// Deadline for the publisher to approve. When it passes, the slot expires
  /// and the advertiser's reserved money for it is released.
  approvalExpiresAt DateTime? @map("approval_expires_at")

  /// PAID = a paying advertiser's creative. HOUSE = BotFlow's own promotion.
  /// The split between the two is governed by paid_ad_share_percent /
  /// house_ad_share_percent so a publisher's feed stays mixed.
  slotType DeliverySlotType @default(PAID) @map("slot_type")

  errorCode    DeliveryErrorCode? @map("error_code")
  errorMessage String?            @map("error_message")

  /// BullMQ job id, for cancellation / inspection.
  queueJobId String? @map("queue_job_id")

  adPost    AdPost?
  events    DeliveryEvent[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([campaignId, channelId, adId, seq])
  @@index([status, scheduledAt])
  @@index([channelId])
  @@map("delivery_jobs")
}

/// A live sponsored post inside a publisher channel.
model AdPost {
  id            String       @id @default(cuid())
  /// Nullable on purpose: a HOUSE post belongs to no campaign and uses no
  /// advertiser creative. Only `houseAdId` identifies what was published.
  campaignId    String?      @map("campaign_id")
  campaign      Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adId          String?      @map("ad_id")
  ad            Ad?          @relation(fields: [adId], references: [id], onDelete: Cascade)
  channelId     String       @map("channel_id")
  channel       Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  publisherId   String       @map("publisher_id")
  publisher     User         @relation("AdPostPublisher", fields: [publisherId], references: [id], onDelete: Cascade)
  deliveryJobId String?      @unique @map("delivery_job_id")
  deliveryJob   DeliveryJob? @relation(fields: [deliveryJobId], references: [id], onDelete: SetNull)

  telegramMessageId BigInt?      @map("telegram_message_id")
  status            AdPostStatus @default(QUEUED)
  publishedAt       DateTime?    @map("published_at")
  deletedAt         DateTime?    @map("deleted_at")

  views        Int @default(0)
  clicks       Int @default(0)
  uniqueClicks Int @default(0) @map("unique_clicks")

  priceCents Int @default(0) @map("price_cents")

  /// How this post was billed. FIXED is an exact, agreed price. CPM and CPC are
  /// up-front ESTIMATES: the Telegram Bot API does not expose per-post view
  /// counts, so the true cost cannot be measured after the fact. Reporting must
  /// never present an estimated figure as if it were measured.
  billingMode String? @map("billing_mode")

  /// ---- CPM payout -------------------------------------------------------
  /// Views are ONLY ever written from a real source. `viewSource` records where
  /// they came from so any figure can be traced back. It stays null when no
  /// source could measure the post — and in that case NO CPM payout is made.
  viewSource     String?   @map("view_source") // MTPROTO | ADMIN | NONE
  viewsSyncedAt  DateTime? @map("views_synced_at")
  /// FIXED = a flat price for the post. CPM = paid per 1,000 measured views.
  earningModel   String?   @map("earning_model")
  cpmEarnedCents Int       @default(0) @map("cpm_earned_cents")

  /// Set when this slot was filled by BotFlow's OWN promotion instead of a paying
  /// advertiser. House posts are never billed to anyone and they are always in
  /// English, because they speak for the platform rather than for a customer.
  houseAdId             String?  @map("house_ad_id")
  houseAd               HouseAd? @relation(fields: [houseAdId], references: [id], onDelete: SetNull)
  publisherEarningCents Int      @default(0) @map("publisher_earning_cents")
  platformFeeCents      Int      @default(0) @map("platform_fee_cents")

  errorCode    DeliveryErrorCode? @map("error_code")
  errorMessage String?            @map("error_message")

  lastStatsSyncAt DateTime? @map("last_stats_sync_at")

  earning    PublisherEarning?
  clicks_rel Click[]
  reports    Report[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([campaignId])
  @@index([channelId, publishedAt])
  @@index([publisherId, status])
  @@index([status])
  @@map("ad_posts")
}

// ============================================================
//  TRACKING
// ============================================================

model Click {
  id         String   @id @default(cuid())
  adId       String   @map("ad_id")
  ad         Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  adPostId   String?  @map("ad_post_id")
  adPost     AdPost?  @relation(fields: [adPostId], references: [id], onDelete: SetNull)
  campaignId String   @map("campaign_id")
  channelId  String?  @map("channel_id")
  channel    Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  userId         String? @map("user_id")
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  telegramUserId BigInt? @map("telegram_user_id")

  ipHash        String? @map("ip_hash")
  userAgentHash String? @map("user_agent_hash")
  country       String?

  isUnique    Boolean @default(true) @map("is_unique")
  isFraud     Boolean @default(false) @map("is_fraud")
  fraudReason String? @map("fraud_reason")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adId, createdAt])
  @@index([campaignId, createdAt])
  @@index([adPostId])
  @@index([isFraud])
  @@map("clicks")
}

/// Periodic view snapshot. Telegram does not expose reliable per-post view
/// counts, so we never invent numbers — we only store what the API returns.
model Impression {
  id       String  @id @default(cuid())
  /// Nullable: a house post has no advertiser creative behind it.
  adId     String? @map("ad_id")
  ad       Ad?     @relation(fields: [adId], references: [id], onDelete: Cascade)
  adPostId String  @map("ad_post_id")

  views      Int      @default(0)
  source     String   @default("telegram_api")
  capturedAt DateTime @default(now()) @map("captured_at")

  @@index([adPostId, capturedAt])
  @@map("impressions")
}

// ============================================================
//  SUPPORT / MODERATION / AUDIT
// ============================================================

model SupportTicket {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)

  ticketNo String         @unique @map("ticket_no")
  subject  String
  category String         @default("general")
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  assignedToId  String?   @map("assigned_to_id")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  closedAt      DateTime? @map("closed_at")

  messages TicketMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String           @id @default(cuid())
  ticketId   String           @map("ticket_id")
  ticket     SupportTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String?          @map("sender_id")
  sender     User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderType TicketSenderType @default(USER) @map("sender_type")

  body          String
  attachmentUrl String? @map("attachment_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model Report {
  id         String  @id @default(cuid())
  reporterId String  @map("reporter_id")
  reporter   User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  adPostId   String? @map("ad_post_id")
  adPost     AdPost? @relation(fields: [adPostId], references: [id], onDelete: SetNull)
  campaignId String? @map("campaign_id")

  reason  ReportReason @default(OTHER)
  details String?
  status  ReportStatus @default(OPEN)

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  actionTaken  String?   @map("action_taken")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([adPostId])
  @@map("reports")
}

model FraudEvent {
  id     String  @id @default(cuid())
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type       FraudType
  severity   FraudSeverity @default(MEDIUM)
  entityType String?       @map("entity_type")
  entityId   String?       @map("entity_id")
  details    Json?

  resolved     Boolean   @default(false)
  resolvedById String?   @map("resolved_by_id")
  resolvedAt   DateTime? @map("resolved_at")
  resolution   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type, severity])
  @@index([resolved])
  @@map("fraud_events")
}

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String? @map("actor_id")
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType String  @default("ADMIN") @map("actor_type")

  action     String
  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  oldValue   Json?   @map("old_value")
  newValue   Json?   @map("new_value")

  ip        String?
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id     String           @id @default(cuid())
  userId String           @map("user_id")
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title String
  body  String
  data  Json?
  link  String?

  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  delivered Boolean   @default(false)
  sentAt    DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
//  SETTINGS (admin-configurable, key/value)
// ============================================================

model Setting {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  valueType   String  @default("string") @map("value_type") // string | int | bool | json
  group       String  @default("general")
  description String?
  isPublic    Boolean @default(false) @map("is_public")
  updatedById String? @map("updated_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

/// Prevents a single channel from being flooded with ads.
model ChannelDeliveryLog {
  id        String   @id @default(cuid())
  channelId String   @map("channel_id")
  adPostId  String?  @map("ad_post_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([channelId, createdAt])
  @@map("channel_delivery_logs")
}

// ============================================================
//  INCREMENT 1 — robustness, audit and forward compatibility
// ============================================================

enum ChannelHealthStatus {
  HEALTHY
  ATTENTION_REQUIRED
  RESTRICTED
  SUSPENDED
}

/// Platform-level policy for an advertising category.
enum CategoryPolicy {
  ALLOWED
  REVIEW_REQUIRED
  BLOCKED
}

enum CreativeVersionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum DeliveryEventType {
  CREATED
  QUEUED
  SCHEDULED
  AWAITING_APPROVAL
  APPROVED_BY_PUBLISHER
  REJECTED_BY_PUBLISHER
  EXPIRED
  PUBLISHING
  PUBLISHED
  CHARGED
  FAILED
  RETRIED
  CANCELLED
}

enum BlocklistScope {
  ADVERTISER
  CAMPAIGN
  CATEGORY
  DOMAIN
}

/// Immutable history of every creative an advertiser has ever submitted.
/// Editing a live campaign appends a new version; nothing is ever overwritten,
/// so a rejected or superseded creative can always be produced on request.
model AdCreativeVersion {
  id   String @id @default(cuid())
  adId String @map("ad_id")
  ad   Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)

  version Int                   @default(1)
  status  CreativeVersionStatus @default(DRAFT)

  format         AdFormat @default(TEXT)
  text           String
  imageUrl       String?  @map("image_url")
  buttonText     String?  @map("button_text")
  buttonUrl      String?  @map("button_url")
  destinationUrl String?  @map("destination_url")

  /// Set when a creative change on an already-approved campaign forces a
  /// re-review. Until then the campaign keeps running the approved version.
  requiresReview Boolean   @default(false)
  reviewedById   String?   @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewNote     String?   @map("review_note")

  changeNote String? @map("change_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([adId, version])
  @@index([adId, status])
  @@map("ad_creative_versions")
}

/// Append-only state history for a delivery. Answers "what happened to this
/// post, in what order, and who caused it" without guessing from the job row.
model DeliveryEvent {
  id            String            @id @default(cuid())
  deliveryJobId String            @map("delivery_job_id")
  deliveryJob   DeliveryJob       @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  type          DeliveryEventType

  actorType String             @default("SYSTEM") @map("actor_type") // SYSTEM | ADMIN | PUBLISHER
  actorId   String?            @map("actor_id")
  message   String?
  errorCode DeliveryErrorCode? @map("error_code")
  attempt   Int                @default(0)
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([deliveryJobId, createdAt])
  @@index([type])
  @@map("delivery_events")
}

/// A publisher's own blocklist. At least one scope field is set.
/// Example: { scope: CATEGORY, value: "CRYPTO" } blocks all crypto campaigns
/// from that channel without touching its global marketplace listing.
model PublisherBlocklist {
  id        String  @id @default(cuid())
  channelId String  @map("channel_id")
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  scope     BlocklistScope
  /// advertiserId | campaignId | category key | domain
  value     String
  label     String?
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([channelId, scope, value])
  @@index([channelId])
  @@map("publisher_blocklist")
}

/// Platform-level blocked / flagged domains. Checked before a campaign is
/// accepted, so a known-bad destination never reaches a publisher channel.
model BlockedDomain {
  id          String   @id @default(cuid())
  domain      String   @unique
  reason      String?
  /// true = hard block, false = allow but route the campaign to review.
  hardBlock   Boolean  @default(true) @map("hard_block")
  channelId   String?  @map("channel_id")
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([domain])
  @@map("blocked_domains")
}

/// A conversion reported back by an advertiser, attributed to the click that
/// produced it.
///
/// This table used to be forward-looking with nothing writing to it. It is now
/// the landing point for the advertiser conversion API: an advertiser (or their
/// agency) posts an event with the `clickId` / tracking slug carried on the ad's
/// destination URL, and the row is attributed back to the campaign, ad, channel
/// and post that earned it.
///
/// `dedupeKey` is UNIQUE on purpose. Conversion postbacks are retried by every
/// sane integrator, and a double-counted conversion inflates an advertiser's
/// reported performance — the same class of bug as a double-charged delivery.
model ConversionEvent {
  id         String  @id @default(cuid())
  clickId    String? @map("click_id")
  adId       String? @map("ad_id")
  adPostId   String? @map("ad_post_id")
  campaignId String? @map("campaign_id")
  channelId  String? @map("channel_id")
  /// The advertiser who owns the campaign this conversion is attributed to.
  advertiserId String? @map("advertiser_id")

  /// Which API credential reported this event, for revocation and forensics.
  /// `SetNull`: revoking a key must never delete the conversions it reported.
  apiKeyId String?           @map("api_key_id")
  apiKey   AdvertiserApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  /// 'postback' | 'pixel' | 'manual'. Free text so new sources need no migration.
  source    String?
  eventName String? @map("event_name")
  valueCents Int?   @map("value_cents")
  currency   String @default("USD")
  /// Raw payload from the conversion source, kept for audit.
  payload    Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  /// Caller-supplied (or derived) idempotency key. UNIQUE.
  dedupeKey String @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([campaignId, occurredAt])
  @@index([clickId])
  @@index([advertiserId, occurredAt])
  @@map("conversion_events")
}

/// Platform policy per advertising category (allowed / review / blocked).
model CategoryPolicyRule {
  id          String          @id @default(cuid())
  category    ChannelCategory @unique
  policy      CategoryPolicy  @default(ALLOWED)
  note        String?
  updatedById String?         @map("updated_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("category_policy_rules")
}

// ============================================================
//  PREMIUM MEMBERSHIP
// ============================================================

enum PlanTier {
  FREE
  PREMIUM
  BUSINESS
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

/// A purchasable plan. `benefits` holds the entitlement deltas so pricing can
/// be changed by an admin without a code deploy.
///
/// Recognised benefit keys (all optional; a missing key means "use the free
/// default"):
///   maxChannels                 number   -1 = unlimited
///   maxActiveCampaigns          number   -1 = unlimited
///   platformFeePercent          number   discounted platform fee
///   publisherEarningBonusPct    number   % uplift on publisher earnings
///   dailyWithdrawLimitCents     number
///   monthlyWithdrawLimitCents   number
///   minWithdrawalCents          number
///   maxCampaignBudgetCents      number
///   channelCooldownHours        number   lower is better
///   maxCampaignsPerHour         number
///   advancedAnalytics           boolean
///   prioritySupport             boolean
///   featuredMarketplace         boolean
///   autoApproveCampaigns        boolean
///   referralBonusPercent        number
model SubscriptionPlan {
  id   String @id @default(cuid())
  code String @unique

  name        String
  description String?
  tier        PlanTier      @default(PREMIUM)
  period      BillingPeriod @default(MONTHLY)

  priceCents   Int    @map("price_cents")
  currency     String @default("USD")
  durationDays Int    @default(30) @map("duration_days")

  benefits Json @default("{}")

  /// Shown first on the pricing page.
  sortOrder  Int     @default(0) @map("sort_order")
  isActive   Boolean @default(true) @map("is_active")
  /// Highlighted as the recommended plan.
  isFeatured Boolean @default(false) @map("is_featured")
  badgeText  String? @map("badge_text")

  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

model Subscription {
  id     String           @id @default(cuid())
  userId String           @map("user_id")
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String           @map("plan_id")
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(PENDING)
  tier   PlanTier           @default(PREMIUM)

  /// Snapshot of what was bought, so a later price change never rewrites
  /// what this member actually paid for.
  pricePaidCents Int    @map("price_paid_cents")
  currency       String @default("USD")
  benefits       Json   @default("{}")

  startedAt DateTime @default(now()) @map("started_at")
  expiresAt DateTime @map("expires_at")

  autoRenew Boolean @default(false) @map("auto_renew")

  /// Ledger reference for the purchase, unique so a retried payment cannot
  /// create a second active subscription.
  paymentReference String? @unique @map("payment_reference")

  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("subscriptions")
}

enum DeliverySlotType {
  PAID
  HOUSE
}

// ============================================================
//  HOUSE ADS — BotFlow's own promotions
// ============================================================

/// BotFlow's own promotional creative.
///
/// Two jobs:
///   1. Fill the reserved non-paid share of every channel (60% by default), so a
///      publisher's feed is never nothing but customer advertising.
///   2. Fill the gap when there is NO paid inventory to deliver. Posting must
///      never simply stop — an empty paid queue falls back to a house post.
///
/// `language` is always 'en'. House posts speak for the platform, so they are
/// written once in English and used everywhere; only a PAID creative follows the
/// advertiser's language. Do not add translated house creatives without a
/// deliberate product decision — mixed-language platform promos read as spam.
model HouseAd {
  id   String  @id @default(cuid())
  /// Stable slug so a creative can be referenced from code or an ops script.
  code String? @unique

  title      String
  body       String
  imageUrl   String? @map("image_url")
  buttonText String? @map("button_text")
  buttonUrl  String? @map("button_url")
  /// Optional extra links, e.g. [{ label: 'X', url: 'https://x.com/...' }]
  links      Json?   @default("[]")

  language String @default("en")

  /// Weighted rotation, exactly like a paid creative.
  weight    Int     @default(1)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  /// Free-text note for the admin UI.
  note String?

  adPosts AdPost[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, weight])
  @@map("house_ads")
}

// ============================================================
//  Advertiser programmatic access
// ============================================================

/// What an API key is allowed to do.
///   READ  — read the advertiser's own campaigns, metrics and invoices.
///   WRITE — create/update campaigns and report conversions back.
enum ApiKeyScope {
  READ
  WRITE
}

/// One API credential for one user.
///
/// The key itself is NEVER stored. Only a SHA-256 hash and a short printable
/// prefix are kept, so a database dump does not hand anyone a working
/// credential. Lookup happens by prefix (indexed), then the presented secret is
/// hashed and compared in constant time.
///
/// Revocation sets `revokedAt`; rows are never deleted, because a conversion or
/// campaign created by a key must stay attributable after the key is gone.
model AdvertiserApiKey {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label  String
  /// First 12 characters of the key, shown in the UI so a user can tell two
  /// credentials apart. Safe to display: it is not enough to authenticate with.
  prefix String @unique
  /// SHA-256 of the full key. Unique so the same secret cannot be issued twice.
  keyHash String @unique @map("key_hash")

  scopes ApiKeyScope[] @default([READ])

  lastUsedAt DateTime? @map("last_used_at")
  lastUsedIp String?   @map("last_used_ip")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  conversionEvents ConversionEvent[]

  @@index([userId, revokedAt])
  @@map("advertiser_api_keys")
}

// ============================================================
//  Outbound webhooks (platform -> advertiser)
// ============================================================

/// Events an advertiser can subscribe to.
///
/// Deliberately a closed enum: an endpoint that subscribes to a typo silently
/// never fires, which is worse than a migration when a new event is added.
enum WebhookEvent {
  CAMPAIGN_APPROVED
  CAMPAIGN_REJECTED
  CAMPAIGN_STARTED
  CAMPAIGN_COMPLETED
  POST_PUBLISHED
  POST_FAILED
  BUDGET_LOW
  CONVERSION_RECORDED
  INVOICE_ISSUED
  EARNINGS_SETTLED
  CHANNEL_APPROVED
  CHANNEL_REJECTED
  /// Fired immediately on creation so a subscriber can verify their endpoint
  /// is reachable and that our signature validates, before real money events.
  TEST
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  /// Retries exhausted. The endpoint is disabled so we stop hammering a dead URL.
  EXHAUSTED
}

/// A subscriber's HTTPS endpoint.
model WebhookEndpoint {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url         String
  description String?
  /// Signing secret. Sent to the subscriber once at creation; every request
  /// carries `X-BotFlow-Signature: sha256=<hmac>` over the raw body.
  secret      String
  events      WebhookEvent[] @default([])
  isActive    Boolean        @default(true) @map("is_active")

  /// Consecutive failures. Reset to 0 by any 2xx delivery.
  failureCount Int       @default(0) @map("failure_count")
  disabledAt   DateTime? @map("disabled_at")

  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([userId, isActive])
  @@map("webhook_endpoints")
}

/// One attempt-log row per (event, endpoint). This is the advertiser-visible
/// delivery log: without it a subscriber has no way to tell whether a missed
/// event was our failure or theirs.
model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String          @map("endpoint_id")
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  event   WebhookEvent
  payload Json

  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  error          String?
  /// Set while a retry is scheduled; the dispatcher only picks up due rows.
  nextAttemptAt  DateTime?             @map("next_attempt_at")

  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

// ============================================================
//  Billing documents
// ============================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

/// An advertiser invoice for one billing period.
///
/// `lineItems` is a JSON snapshot of the ledger rows that produced the total, so
/// a later ledger change can never silently rewrite an already-issued document.
model Invoice {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Human-readable and unique, e.g. ADZ-2026-07-000123.
  number String @unique

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  currency      String @default("USD")
  subtotalCents Int    @map("subtotal_cents")
  refundCents   Int    @default(0) @map("refund_cents")
  totalCents    Int    @map("total_cents")

  status InvoiceStatus @default(ISSUED)

  /// Snapshot: [{ description, quantity, unitAmountCents, amountCents, reference }]
  lineItems Json @default("[]") @map("line_items")

  issuedAt DateTime  @default(now()) @map("issued_at")
  sentAt   DateTime? @map("sent_at")
  paidAt   DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, periodStart])
  @@index([status])
  @@map("invoices")
}

// ============================================================
//  Security alerts
// ============================================================

/// One Mini App session start, used to decide whether a sign-in looks new.
///
/// The raw IP is never stored: `ipHash` and `userAgentHash` are salted hashes,
/// which is enough to answer "have we seen this device before?" without keeping
/// a record that identifies where a user was.
model LoginEvent {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipHash        String  @map("ip_hash")
  userAgentHash String? @map("user_agent_hash")
  /// Coarse, human-readable label derived from the user agent, e.g. "Telegram iOS".
  deviceLabel   String? @map("device_label")
  country       String?

  /// True when this (user, ip) pair had never been seen before.
  isNewDevice Boolean @default(false) @map("is_new_device")
  /// Set once we have decided not to alert again about this device.
  alertedAt   DateTime? @map("alerted_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, ipHash])
  @@map("login_events")
}
