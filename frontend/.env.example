# Backend API base URL (no trailing slash).
# Local dev: the API started with `npm run dev:api` on port 10000.
# IMPORTANT: in production this MUST point at the deployed `botflow-api`
# service URL (e.g. https://botflow-api.onrender.com). Vite bakes the value
# into the bundle at build time, so set it as a build-time env var on the
# static site service (see render.yaml) and rebuild after changing it.
VITE_API_URL=http://localhost:10000
